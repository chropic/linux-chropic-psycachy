+		if (ret)
+			goto err_cb_deinit;
+	}
 
 	ret = v4l2_device_register(dev, &core->v4l2_dev);
 	if (ret)
@@ -365,7 +444,10 @@
 err_v4l2_unreg:
 	v4l2_device_unregister(&core->v4l2_dev);
 err_unresv_iova_region:
-	iris_unreserve_iova_region(dev, core->iova_state);
